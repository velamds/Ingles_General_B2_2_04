"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": []}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn10le04ob01re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " \nResearch and choose a self-improvement course.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn10le04ob01re2img01.jpg"}, {"text": "<span class=\"strong\">Amy</span>: Good morning everyone, and welcome to your first session of life-coaching! Before we start with our session today, I'll introduce myself. I'm Amy Watson. I'm going to give you the tools to make your life fuller and more rewarding. With five sessions you are going to expand your potential, reduce stress, learn to sustain your success, and nurture your relationships. Essentially, there is no magic here. We will be doing exercises on discovering your inner strength, and that discovery will lead to true success. If you can commit to being here for five sessions, you will reach a level of contentment by learning techniques to facilitate relaxation and peace of mind.", "id": 1, "time": "0", "image": "engenn10le04ob01re2img01.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: Hi everyone. I'm Vanessa. A lot of my ideas seem to be changing since my friend Sally moved away. I work in  a restaurant. More specifically, I am the manager. While I love my job and working with food, I'm hoping to realize my full potential. Furthermore, I always feel I'm holding myself back and that I would benefit from a course such as this one. When I finish this course, I feel that positive change will be possible.", "id": 2, "time": "38000", "image": "engenn10le04ob01re2img03.jpg"}, {"text": "<span class=\"strong\">Amy</span>: Thanks Vanessa, and what about you?", "id": 3, "time": "70000", "image": "engenn10le04ob01re2img01.jpg"}, {"text": "<span class=\"strong\">Will</span>: Hi. I'm Will. Although it's taken me some time to reach the decision to come here, I feel quite pleased to be with you today. I will be heading to South Asia to teach in a couple of months, but have realized I experience anxiety and also need to boost my self-esteem.  At any rate, I guess I feel ready to change a few things and just open up to new possibilities. When I gain a little more confidence, I am going to propose to my girlfriend.", "id": 4, "time": "71500", "image": "engenn10le04ob01re2img02.jpg"}, {"text": "<span class=\"strong\">Amy</span>: That's great Will.  How about the next person ...", "id": 5, "time": "96000", "image": "engenn10le04ob01re2img01.jpg"}], "audiosrc": "engenn10le04ob01re2aud01", "coverimg": "engenn10le04ob01re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}